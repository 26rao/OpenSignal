# Bright Data
BRIGHT_DATA_API_KEY=your_api_key_here

# Collector IDs from Scraper Studio (replace c_REPLACE_ME after create)
COLLECTOR_ARTIST_COMMUNITIES=c_REPLACE_ME
# Optional second source — leave as REPLACE_ME until you create it
COLLECTOR_NYFA=c_REPLACE_ME

# Runtime
OPEN_SIGNAL_DB_PATH=./data/opensignal.db
LOG_LEVEL=INFO
QUALITY_THRESHOLD=0.85
# Keep false for controlled demo; set true only after you trust heal prompts
AUTO_APPROVE_HEAL=false
